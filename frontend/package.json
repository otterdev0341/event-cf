{
  "name": "event-confirm-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/swagger.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/swagger.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.60.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "5.33.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
