# Public Supabase URL and publishable key (safe in browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix Voice Bot credentials with VITE_.
VOICE_BOT_BASE_URL=https://api-voicebot-stg.botnoigroup.com
VOICE_BOT_ACCESS_TOKEN=
# members (default): every signed-in user with a confirmed email can use Voice Bot.
VOICE_ACCESS_MODE=members
# Optional: only used when VOICE_ACCESS_MODE=allowlist. Empty lists then deny access.
VOICE_ALLOWED_EMAILS=
VOICE_ALLOWED_USER_IDS=
VITE_AGENT_WEDDING_ID=
VITE_AGENT_CONFIRM_ID=
VITE_AGENT_EVENT_CONFIRM_ID=

# Server-only inbound Agent HTTP Tool (optional until configured).
# Supabase service_role key: NEVER give this key to the Agent or browser.
SUPABASE_SERVICE_ROLE_KEY=
# Separate random secret, minimum 32 characters. Share ONLY this secret with the HTTP Tool.
VOICE_RESULT_CALLBACK_SECRET=
# Agent setup is restricted to server-configured administrators. Never prefix these with VITE_.
VOICE_ADMIN_EMAILS=
VOICE_ADMIN_USER_IDS=
VOICE_RESULT_CALLBACK_URL=https://voice-confirm-two.vercel.app/api/voice-result
