{
  "patch": {
    "operationId": "patch-orgs-org-events-event-queue-policy",
    "summary": "PATCH /orgs/{org}/events/{event}/queue-policy",
    "parameters": [
      {
        "name": "org",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "event",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "ratio": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "expectedVersion": {
                "type": "integer"
              }
            },
            "required": [
              "ratio",
              "expectedVersion"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/queueSchema.json"
            }
          }
        }
      },
      "default": {
        "description": "401/403/404/409/422/429/503 error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      }
    }
  }
}
