{
  "post": {
    "operationId": "post-agent-orgs-org-events-event-calls-attempt-result",
    "summary": "POST /agent/orgs/{org}/events/{event}/calls/{attempt}/result",
    "security": [
      {
        "OrgCredential": [],
        "EventCredential": []
      }
    ],
    "parameters": [
      {
        "name": "org",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "event",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "attempt",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "result": {
                "enum": [
                  "confirm",
                  "decline",
                  "unknown"
                ]
              },
              "reason": {
                "enum": [
                  null,
                  "no_answer",
                  "noisy_audio",
                  "ai_cannot_infer"
                ]
              },
              "ticket": {
                "$ref": "../schemas/ticketInputSchema.json"
              }
            },
            "required": [
              "result",
              "reason"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        }
      },
      "default": {
        "description": "401/403/404/409/422/429/503 error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      }
    }
  }
}
