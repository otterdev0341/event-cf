{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "lane": {
      "type": "string",
      "enum": [
        "new",
        "fail",
        "done"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "delayed",
        "stopped",
        "awaiting_result"
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "confirm"
            },
            "reason": {
              "type": "null"
            }
          },
          "required": [
            "result",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "decline"
            },
            "reason": {
              "type": "null"
            }
          },
          "required": [
            "result",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "enum": [
                "no_answer",
                "noisy_audio",
                "ai_cannot_infer"
              ]
            }
          },
          "required": [
            "result",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "type": "null"
            },
            "reason": {
              "type": "null"
            }
          },
          "required": [
            "result",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "noAnswerCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "transport": {
            "type": "string"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "string",
                    "const": "confirm"
                  },
                  "reason": {
                    "type": "null"
                  }
                },
                "required": [
                  "result",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "string",
                    "const": "decline"
                  },
                  "reason": {
                    "type": "null"
                  }
                },
                "required": [
                  "result",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "no_answer",
                      "noisy_audio",
                      "ai_cannot_infer"
                    ]
                  }
                },
                "required": [
                  "result",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "null"
                  }
                },
                "required": [
                  "result",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "transport",
          "outcome",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "phone",
    "firstName",
    "lastName",
    "nickname",
    "lane",
    "state",
    "outcome",
    "noAnswerCount",
    "attempts"
  ],
  "additionalProperties": false
}
