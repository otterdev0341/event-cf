{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventCode": {
      "type": "string"
    },
    "categoryRevision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "rows": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "question",
          "answer",
          "category"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "eventCode",
    "categoryRevision",
    "rows"
  ],
  "additionalProperties": false
}
