{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{2,40}$"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "code",
        "date",
        "location",
        "description",
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        }
      },
      "required": [
        "expectedVersion",
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
