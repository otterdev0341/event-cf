{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "number"
    }
  },
  "required": [
    "question",
    "answer",
    "category",
    "id",
    "version"
  ],
  "additionalProperties": false
}
