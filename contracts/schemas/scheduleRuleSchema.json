{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "once",
        "daily",
        "weekly"
      ]
    },
    "weekdays": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "redial": {
      "type": "boolean"
    },
    "participantIds": {
      "minItems": 1,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedEventVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "consent": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "date",
    "time",
    "recurrence",
    "weekdays",
    "redial",
    "participantIds",
    "expectedEventVersion",
    "consent"
  ],
  "additionalProperties": false
}
