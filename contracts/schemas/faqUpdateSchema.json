  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "question",
    "answer",
    "category",
    "expectedVersion"
  ],
  "additionalProperties": false
}
