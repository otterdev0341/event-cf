{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "type": {
      "type": "string",
      "enum": [
        "unanswered",
        "callback"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "assignee": {
      "type": "string",
      "maxLength": 120
    },
    "dueDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "eventId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "type",
    "description",
    "assignee",
    "dueDate",
    "id",
    "eventId",
    "status",
    "version",
    "comments",
    "activity"
  ],
  "additionalProperties": false
}
