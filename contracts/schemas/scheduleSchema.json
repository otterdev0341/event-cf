{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "rule": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "recurrence": {
          "type": "string",
          "enum": [
            "once",
            "daily",
            "weekly"
          ]
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "redial": {
          "type": "boolean"
        },
        "participantIds": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedEventVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "consent": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "date",
        "time",
        "recurrence",
        "weekdays",
        "redial",
        "participantIds",
        "expectedEventVersion",
        "consent"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "running",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nextAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completedRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "rule",
    "status",
    "version",
    "nextAt",
    "completedRuns"
  ],
  "additionalProperties": false
}
