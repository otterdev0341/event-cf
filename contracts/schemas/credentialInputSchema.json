{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "type": "string",
      "enum": [
        "org",
        "event"
      ]
    },
    "eventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "events:read",
          "knowledge:read",
          "tickets:create",
          "calls:read",
          "calls:create",
          "calls:result"
        ]
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "name",
    "kind",
    "eventId",
    "parentId",
    "scopes",
    "expiresAt"
  ],
  "additionalProperties": false
}
