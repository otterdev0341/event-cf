@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam dpi 130
skinparam componentStyle rectangle
top to bottom direction
title Event Confirm — Target architecture
caption PROPOSED: frontend-first refactor; not the currently deployed application.
actor "Staff / Org member" as Staff
actor "External AI agent" as Agent
cloud "Voice provider" as Voice
node "Lightsail instance / Docker Compose" {
  component "HTTPS reverse proxy\n/event-confirm/" as Edge #EAF2FF
  package "Frontend — React / TypeScript / Vite / Tailwind" {
    component "Reusable components + pages\nEvents / FAQ / Participants / Queues / Kanban" as UI #EAF2FF
    component "Hooks -> services -> DTO validation\nZustand: UI state / query cache: server data" as FE #EAF2FF
    UI --> FE
  }
  package "Rust API — ntex / Tokio async modular monolith" {
    component "HTTP routes + DTO validation\nBrowser: email/password + session\nAgent: org credential AND event credential\nProvider: authenticated callbacks" as HTTP #E7F5ED
    component "Auth / Organizations\nMembership + roles + tenant authorization" as Auth #E7F5ED
    component "Events / categorized FAQ\nPublished knowledge for agents" as Knowledge #E7F5ED
    component "Participants / Imports\nTemplate download -> preview -> commit\nExplicit start required" as Imports #E7F5ED
    component "Calling / Results / Queue policy\nconfirm | decline | unknown + reason" as Calling #E7F5ED
    component "Tickets / Kanban\nUnanswered questions / callback requests\nIndependent of attendance result" as Tickets #E7F5ED
    component "Async repositories / SeaORM\nTenant-scoped queries + transactions" as Repo #E7F5ED
    HTTP --> Auth
    HTTP --> Knowledge
    HTTP --> Imports
    HTTP --> Calling
    HTTP --> Tickets
    Auth --> Repo
    Knowledge --> Repo
    Imports --> Repo
    Calling --> Repo
    Tickets --> Repo
  }
  database "PostgreSQL\nOrg / Event / FAQ / Participants / Tickets\nAttempts + results + audit + credentials\ncall_jobs: NEW / FAIL + durable Event ratio" as DB #FFF8DF
  component "Async Rust worker — separate process, same codebase\nShared calling services + repository interfaces\nAtomic claim / leases / reconciliation\nX NEW : 1 FAIL; count accepted dispatch once" as Worker #FFF8DF
  Edge --> UI : static assets
  FE --> Edge : HTTPS API
  Edge --> HTTP
  Repo --> DB
  Worker --> DB : short transactions\nclaim / persist / retry scheduling
}
Staff --> Edge
Agent --> Edge : FAQ / tickets / call results\npaired credentials + scopes
Worker --> Voice : outside transaction\nstable request identity
Voice --> Edge : signed transport callbacks
cloud "Off-host encrypted backups" as Backup
DB ..> Backup
node "Jenkins CI — separate build host" {
  component "Frontend + Rust checks / <=300 code lines\nGroovy + Spock API tests / JUnit\nIsolated DB + fake voice provider" as CI
}
CI ..> Edge : tested image deployment
legend bottom left
  NEW: imported recipients after explicit run start.
  FAIL: terminal unknown with an eligible reason; cooldown + attempt limit.
  Confirm/decline stop automatic retries. Tickets do not change attendance.
  Ambiguous dispatch or missing result: reconcile; never blind redial.
  MVP has no extra queue broker. One instance is not high availability.
endlegend
@enduml
