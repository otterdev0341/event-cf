{
  "version": "0.2.0",
  "status": "frontend_demo_implemented_backend_pending",
  "backendImplemented": false,
  "navigation": {
    "organization": "searchable_topbar_combobox",
    "events": "searchable_org_scoped_sidebar",
    "settings": [
      "theme",
      "organizations",
      "team_management",
      "agent_access",
      "swagger_ui"
    ]
  },
  "roles": {
    "root": {
      "scope": "platform",
      "orgGrantable": false
    },
    "org_admin": {
      "scope": "organization",
      "permissions": [
        "team",
        "credentials",
        "all_event_operations"
      ]
    },
    "event_admin": {
      "scope": "granted_events",
      "permissions": [
        "event",
        "knowledge",
        "participants",
        "calling",
        "tickets"
      ]
    },
    "team_member": {
      "scope": "organization_read_and_granted_event_tickets",
      "permissions": [
        "read",
        "ticket_operations"
      ]
    }
  },
  "tickets": {
    "stages": [
      "open",
      "in_progress",
      "waiting",
      "resolved"
    ],
    "views": [
      "board",
      "table"
    ],
    "assigneeIds": "multiple_active_org_member_ids",
    "concurrency": "expectedVersion"
  },
  "dashboard": {
    "library": "chart.js",
    "timezone": "Asia/Bangkok",
    "calls": {
      "dailyDays": 7,
      "weeklyWeeks": 8,
      "weekStarts": "Monday"
    },
    "metrics": [
      "outbound_attempts",
      "open_tickets",
      "member_open_closed_assignments",
      "updated_faq",
      "queue_people",
      "actionable_remaining_people"
    ]
  },
  "queue": {
    "ratio": "new_to_retry",
    "maxRetries": {
      "minimum": 0,
      "maximum": 10,
      "default": 2
    },
    "maxAttemptsFormula": "maxRetries + 1",
    "exhaustion": "stop_retry_keep_unknown_reason_and_history",
    "graphic": "lane_tiles_and_illustrative_dispatch_strip"
  },
  "participantTemplate": {
    "formats": [
      "csv",
      "xlsx"
    ],
    "columns": [
      "phone",
      "first_name",
      "last_name",
      "nickname",
      "event_code",
      "event_date",
      "lang_code"
    ],
    "languageRequired": true,
    "templateLanguage": "th",
    "supportedDemoCodes": [
      "th",
      "en",
      "ja",
      "zh",
      "ko",
      "vi",
      "id",
      "ms",
      "fr",
      "de",
      "es",
      "ar"
    ]
  },
  "knowledge": {
    "scope": "event",
    "tabs": [
      "draft",
      "published",
      "categories",
      "template_import"
    ],
    "categoryCrud": true,
    "templateSheets": [
      "FAQ",
      "Categories",
      "Event"
    ],
    "categoryRevisionRequired": true,
    "importAtomic": true,
    "importPublishes": false,
    "limits": {
      "compressedMiB": 5,
      "expandedMiB": 25,
      "faqRows": 1000
    }
  },
  "swagger": {
    "ui": "/event-confirm/swagger-ui/",
    "redirectFrom": "/event-confirm/swagger-ui",
    "json": "/event-confirm/swagger-ui/openapi.json",
    "openapi": "3.1.0",
    "tryItOut": false
  },
  "remainingPhases": [
    "P6",
    "P7",
    "P7a",
    "P7b",
    "P8",
    "P9"
  ],
  "verification": [
    "role_scope_negative_tests",
    "org_event_search",
    "multi_assignee_cross_org_rejection",
    "drag_drop_4_stages_table",
    "knowledge_template_revision_atomicity",
    "language_validation",
    "retry_cap",
    "daily_weekly_counts",
    "swagger_local_refs",
    "mobile_and_theme"
  ]
}
