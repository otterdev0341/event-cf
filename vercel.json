{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/voice-events.mjs": {
      "maxDuration": 30
    },
    "api/voice.mjs": {
      "maxDuration": 60
    },
    "api/voice-result.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
